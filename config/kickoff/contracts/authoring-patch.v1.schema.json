{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kickoff/authoring-patch.v1",
  "type": "object",
  "required": [
    "patch_meta",
    "target",
    "source_contract_refs",
    "preconditions",
    "operations",
    "quality_expectations"
  ],
  "additionalProperties": false,
  "properties": {
    "patch_meta": {
      "type": "object",
      "required": [
        "contract_version",
        "patch_id",
        "patch_kind",
        "generated_by_tool",
        "generated_at",
        "iteration"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_version": { "const": 1 },
        "patch_id": { "type": "string", "minLength": 1 },
        "patch_kind": {
          "type": "string",
          "enum": [
            "local-llm-assisted-candidate",
            "local-llm-assisted-runtime-simulation"
          ]
        },
        "generated_by_tool": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "iteration": { "type": "integer", "minimum": 1 },
        "parent_patch_id": { "type": ["string", "null"] },
        "repair_of_patch_id": { "type": ["string", "null"] }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "mode",
        "suite_label",
        "expected_seed_profile",
        "target_environment",
        "target_batch_scope"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["candidate", "active"] },
        "suite_label": { "type": "string", "minLength": 1 },
        "expected_seed_profile": { "const": "launch" },
        "target_environment": { "const": "local" },
        "target_batch_scope": { "type": "string", "enum": ["kickoff", "warmup", "both"] }
      }
    },
    "source_contract_refs": { "type": "object" },
    "preconditions": { "type": "object" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op_id", "action", "entity_kind", "logical_key", "payload"],
        "additionalProperties": true,
        "properties": {
          "op_id": { "type": "string", "minLength": 1 },
          "action": {
            "type": "string",
            "enum": ["create", "attach_media", "runtime_instruction"]
          },
          "entity_kind": {
            "type": "string",
            "enum": ["post", "thread", "turn", "vote", "media", "runtime_instruction"]
          },
          "logical_key": { "type": "string", "minLength": 1 },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "target_batch_kind": { "type": "string", "enum": ["kickoff", "warmup"] },
          "generation_mode": {
            "type": "string",
            "enum": ["warmup_candidate", "warmup_topup_candidate", "governance_restore"]
          }
        }
      }
    },
    "quality_expectations": { "type": "object" },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
