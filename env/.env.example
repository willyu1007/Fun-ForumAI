# RUNTIME_POST_MAX_PER_DAY: Daily cap for autonomous runtime posts.; type=int; optional; default=50
RUNTIME_POST_MAX_PER_DAY=50

# RUNTIME_QUEUE_BACKEND: Runtime event queue backend selection.; type=enum; optional; default='in-memory'
RUNTIME_QUEUE_BACKEND=in-memory

# RUNTIME_QUEUE_MAX_RETRIES: Max retry attempts before moving runtime event to DLQ.; type=int; optional; default=3
RUNTIME_QUEUE_MAX_RETRIES=3

# RUNTIME_QUEUE_POLL_TIMEOUT_MS: Blocking poll timeout for queue dequeue operations.; type=int; optional; default=100
RUNTIME_QUEUE_POLL_TIMEOUT_MS=100

# RUNTIME_QUEUE_VISIBILITY_TIMEOUT_MS: Pending message visibility timeout for runtime queue consumers.; type=int; optional; default=60000
RUNTIME_QUEUE_VISIBILITY_TIMEOUT_MS=60000

# RUNTIME_REDIS_CONNECT_TIMEOUT_MS: Redis connection timeout in milliseconds for runtime infra.; type=int; optional; default=5000
RUNTIME_REDIS_CONNECT_TIMEOUT_MS=5000

# RUNTIME_REDIS_PREFIX: Redis key prefix for runtime queue, DLQ, and lock keys.; type=string; optional; default='llm-forum:runtime'
RUNTIME_REDIS_PREFIX=llm-forum:runtime

# RUNTIME_REDIS_URL: Redis connection URL for runtime shared state.; type=string; optional; secret_ref=runtime_redis_url
RUNTIME_REDIS_URL=<secret:runtime_redis_url>

# SERVICE_AUTH_SECRET: Shared HMAC secret for Agent Runtime ↔ Core Social service-to-service auth.; type=string; required; secret_ref=service_auth_secret
SERVICE_AUTH_SECRET=<secret:service_auth_secret>

# SERVICE_NAME: Service name (logical).; type=string; required; default='llm-forum'
SERVICE_NAME=llm-forum

# SMTP_FROM_EMAIL: Sender email address for email verification messages.; type=string; optional
SMTP_FROM_EMAIL=

# SMTP_FROM_NAME: Sender display name for email verification messages.; type=string; optional; default='Fun Forum AI'
SMTP_FROM_NAME=Fun Forum AI

# SMTP_HOST: SMTP server hostname used to send email verification codes.; type=string; optional
SMTP_HOST=

# SMTP_PASS: SMTP password used for email verification delivery.; type=string; optional; secret_ref=smtp_pass
SMTP_PASS=<secret:smtp_pass>

# SMTP_PORT: SMTP server port used for email verification delivery.; type=int; optional; default=587
SMTP_PORT=587

# SMTP_SECURE: Whether SMTP connections should use TLS from connect time.; type=enum; optional; default='false'
SMTP_SECURE=false

# SMTP_USER: SMTP username used for email verification delivery.; type=string; optional; secret_ref=smtp_user
SMTP_USER=<secret:smtp_user>

# SSE_BROADCAST_BACKEND: SSE broadcast backend selection for cross-instance fanout.; type=enum; optional; default='local'
SSE_BROADCAST_BACKEND=local

# SSE_REDIS_CHANNEL: Redis Pub/Sub channel name for SSE broadcast envelopes.; type=string; optional; default='llm-forum:sse:broadcast'
SSE_REDIS_CHANNEL=llm-forum:sse:broadcast

# SSE_REDIS_CONNECT_TIMEOUT_MS: Redis connection timeout in milliseconds for SSE broadcast backend.; type=int; optional; default=5000
SSE_REDIS_CONNECT_TIMEOUT_MS=5000

# SSE_REDIS_URL: Redis connection URL for SSE cluster broadcast backend.; type=string; optional; secret_ref=sse_redis_url
SSE_REDIS_URL=<secret:sse_redis_url>

# TENCENT_HUNYUAN_API_KEY: Tencent Hunyuan provider API key.; type=string; optional; secret_ref=tencent_hunyuan_api_key
TENCENT_HUNYUAN_API_KEY=<secret:tencent_hunyuan_api_key>

# TENCENT_HUNYUAN_API_KEY_SECONDARY: Secondary Tencent Hunyuan provider API key for ordered failover.; type=string; optional; secret_ref=tencent_hunyuan_api_key_secondary
TENCENT_HUNYUAN_API_KEY_SECONDARY=<secret:tencent_hunyuan_api_key_secondary>

# VITE_API_URL: Frontend API base URL (Vite env variable, only used in build).; type=string; optional; default='/v1'
VITE_API_URL=/v1

# VITE_FF_AFTERSHOW_V1: Frontend toggle for loading post aftershow summaries and highlight callouts.; type=enum; optional; default='false'
VITE_FF_AFTERSHOW_V1=false

# VITE_FF_AGENT_STATS_UI: Frontend toggle for exposing Agent Stats tab in owner profile.; type=enum; optional; default='false'
VITE_FF_AGENT_STATS_UI=false

# VITE_FF_AUDIENCE_AFTERSHOW_WEB_V1: Frontend master toggle for rendering the audience/aftershow rail on post detail.; type=enum; optional; default='false'
VITE_FF_AUDIENCE_AFTERSHOW_WEB_V1=false

# VITE_FF_AUDIENCE_ZONE_V1: Frontend toggle for loading post audience thread and composer surfaces.; type=enum; optional; default='false'
VITE_FF_AUDIENCE_ZONE_V1=false

# VITE_FF_GLOBAL_HIGHLIGHTS_V1: Frontend toggle for showing the global highlights entry/page.; type=enum; optional; default='true'
VITE_FF_GLOBAL_HIGHLIGHTS_V1=true

# VITE_FF_GUIDANCE_BELL_V1: Frontend toggle for rendering the guidance section inside the shared notification bell.; type=enum; optional; default='false'
VITE_FF_GUIDANCE_BELL_V1=false

# VITE_FF_GUIDANCE_V1: Frontend toggle for loading and rendering guidance entry points, inbox, and receipt surfaces.; type=enum; optional; default='false'
VITE_FF_GUIDANCE_V1=false

# VITE_FF_HOME_PROGRAMMING_V1: Frontend toggle for switching `/` from the legacy feed entry to the launch programming home surface.; type=enum; optional; default='false'
VITE_FF_HOME_PROGRAMMING_V1=false

# VITE_FF_PROGRAMMING_OPS_V1: Frontend toggle for loading the Admin Programming tab and its launch ops read model.; type=enum; optional; default='false'
VITE_FF_PROGRAMMING_OPS_V1=false

# VITE_FF_ROLE_ASSIGNMENT_V1: Frontend toggle for loading post aside-seat / role-assignment read models.; type=enum; optional; default='false'
VITE_FF_ROLE_ASSIGNMENT_V1=false

# ZAI_API_KEY: ZAI / GLM provider API key.; type=string; optional; secret_ref=zai_api_key
ZAI_API_KEY=<secret:zai_api_key>

# ZAI_API_KEY_SECONDARY: Secondary ZAI / GLM provider API key for ordered failover.; type=string; optional; secret_ref=zai_api_key_secondary
ZAI_API_KEY_SECONDARY=<secret:zai_api_key_secondary>
