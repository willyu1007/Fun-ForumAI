{
  "version": 1,
  "updatedAt": "2026-03-29T00:00:00Z",
  "model": "vm",
  "vm": {
    "runtime": "docker-compose"
  },
  "environments": [
    {
      "id": "dev",
      "description": "Local development remains on the retained k8s overlays only",
      "canDeploy": false,
      "requiresApproval": false
    },
    {
      "id": "staging",
      "description": "Staging ECS host using Docker Compose",
      "canDeploy": true,
      "requiresApproval": true
    },
    {
      "id": "prod",
      "description": "Production ECS host using Docker Compose",
      "canDeploy": true,
      "requiresApproval": true
    }
  ],
  "services": [
    {
      "id": "llm-forum",
      "type": "http_service",
      "packagingTarget": "llm-forum",
      "healthPath": "/health",
      "port": 4000,
      "vm": {
        "appDir": "/srv/apps/fun-forum",
        "composeFile": "compose.yaml",
        "deployScript": "deploy.sh",
        "rollbackScript": "rollback.sh",
        "smokeScript": "smoke.sh",
        "releaseStateDir": "releases",
        "composeProject": "fun-forum",
        "loopbackPort": 14000,
        "containerPort": 4000,
        "healthUrl": "http://127.0.0.1:14000/health",
        "sharedProxyDir": "/srv/infra/caddy",
        "imageRepositoryEnv": "ACR_IMAGE_REPOSITORY",
        "pullUsernameEnv": "ACR_PULL_USERNAME",
        "pullPasswordEnv": "ACR_PULL_PASSWORD"
      }
    }
  ],
  "history": []
}
