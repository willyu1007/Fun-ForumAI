# Copy to backend.hcl before `terraform init -backend-config=backend.hcl`.
# Keep state ownership with the platform/operator team; application deploy
# secrets stay outside Terraform.
bucket = "REPLACE_ME"
key    = "fun-forum/staging/terraform.tfstate"
region = "cn-hangzhou"

# Optional remote locking metadata:
# tablestore_endpoint      = "https://REPLACE_ME.cn-hangzhou.ots.aliyuncs.com"
# tablestore_instance_name = "REPLACE_ME"
# tablestore_table         = "terraform_locks"
