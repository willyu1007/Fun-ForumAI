{
  "name": "llm-only-forum-chat",
  "version": "0.1.0",
  "description": "Agent-led forum and chat platform with governed human public participation, auditable agent runtime, and forest-first reading.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "concurrently -n be,fe -c blue,green \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:chatroom:hold": "concurrently -n be,fe -c blue,green \"pnpm dev:backend\" \"pnpm dev:frontend:chatroom:hold\"",
    "dev:backend": "tsx watch src/backend/server.ts",
    "predev:backend": "pnpm db:generate",
    "dev:frontend": "vite",
    "dev:frontend:chatroom:hold": "VITE_FF_CHATROOM_STAGING_HOLD_V1=true vite",
    "dev:frontend:kind": "concurrently -k -n tunnel,fe -c magenta,green \"node scripts/k8s-backend-tunnel.mjs\" \"pnpm dev:frontend\"",
    "predev:frontend": "pnpm ui:build",
    "mobile:dev": "pnpm --filter @fun-forum/mobile dev",
    "premobile:dev": "pnpm ui:build",
    "mobile:dev:ios": "pnpm --filter @fun-forum/mobile dev:ios",
    "premobile:dev:ios": "pnpm ui:build",
    "mobile:dev:android": "pnpm --filter @fun-forum/mobile dev:android",
    "premobile:dev:android": "pnpm ui:build",
    "mobile:typecheck": "pnpm --filter @fun-forum/mobile typecheck",
    "premobile:typecheck": "pnpm ui:build",
    "mobile:test": "pnpm --filter @fun-forum/mobile test",
    "premobile:test": "pnpm ui:build",
    "mobile:doctor": "node scripts/mobile-doctor.mjs",
    "mobile:devbuild:ios": "node scripts/mobile-eas-build.mjs ios",
    "mobile:devbuild:android": "node scripts/mobile-eas-build.mjs android",
    "mobile:run:ios": "node scripts/mobile-run-local.mjs ios",
    "mobile:run:android": "node scripts/mobile-run-local.mjs android",
    "mobile:config:check": "node scripts/mobile-config-check.mjs",
    "mobile:smoke:prepare": "node scripts/mobile-smoke-prepare.mjs",
    "mobile:smoke:ios": "node scripts/mobile-smoke-run.mjs ios",
    "mobile:smoke:android": "node scripts/mobile-smoke-run.mjs android",
    "mobile:smoke:validate": "node scripts/mobile-maestro-check.mjs",
    "build": "vite build",
    "prebuild": "pnpm ui:build",
    "start": "tsx src/backend/server.ts",
    "prestart": "pnpm db:generate",
    "pretypecheck": "pnpm db:generate && pnpm ui:build",
    "typecheck": "tsc -b",
    "lint": "eslint src apps/mobile/src packages scripts ops .ai/scripts",
    "pretest": "pnpm ui:build",
    "test": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "test:e2e:playwright": "playwright test --config=playwright.config.mjs",
    "test:e2e:playwright:update": "playwright test --config=playwright.config.mjs --update-snapshots",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio",
    "db:local:up": "node scripts/db-local.mjs up",
    "db:local:wait": "node scripts/db-local.mjs wait",
    "db:local:status": "node scripts/db-local.mjs status",
    "db:local:logs": "node scripts/db-local.mjs logs",
    "db:local:down": "node scripts/db-local.mjs down",
    "db:local:migrate": "pnpm db:local:up && pnpm db:local:wait && pnpm db:migrate:dev",
    "search:rebuild-docs": "tsx src/backend/dev/rebuild-search-docs.ts",
    "forum:audit:participation-contract-overrides": "tsx src/backend/dev/backfill-participation-contract-overrides.ts",
    "forum:backfill:participation-contract-overrides": "tsx src/backend/dev/backfill-participation-contract-overrides.ts --apply",
    "llm:routing:generate": "tsx scripts/generate-voice-line-routing-artifact.mjs",
    "media:backfill-lineage": "tsx src/backend/dev/backfill-media-lineage.ts",
    "media:inject": "tsx src/backend/dev/media-inject.ts",
    "agent-bio:backfill": "tsx src/backend/dev/backfill-agent-social-bio.ts",
    "agent-bio:measure": "tsx src/backend/dev/measure-agent-social-bio.ts",
    "voice-line:canonicalize-doubao": "tsx src/backend/dev/canonicalize-doubao-voice-line.ts",
    "package:dry-run": "node ops/packaging/scripts/build.mjs --dry-run",
    "package:build": "node ops/packaging/scripts/build.mjs",
    "deploy:dry-run": "node ops/deploy/scripts/deploy.mjs --dry-run --env staging --with-migrate",
    "deploy:plan": "node ops/deploy/scripts/deploy.mjs --dry-run --env",
    "rollback:dry-run": "node ops/deploy/scripts/rollback.mjs --dry-run --env staging",
    "release:status": "node .ai/skills/features/release/scripts/ctl-release.mjs status",
    "seed": "tsx src/backend/dev/seed-dev-data.ts",
    "launch:bootstrap:memberships": "tsx src/backend/dev/bootstrap-launch-memberships.ts",
    "launch:canonicalize:semantic-fields": "tsx src/backend/dev/canonicalize-launch-semantic-fields.ts",
    "launch.kickoff": "tsx src/backend/dev/launch-kickoff.ts",
    "launch.enrichment": "tsx src/backend/ops/launch-enrichment.ts",
    "launch.gray.promote": "tsx src/backend/ops/launch-gray-promote.ts",
    "launch.cleanup.invalid": "tsx src/backend/ops/cleanup-invalid-launch-content.ts",
    "launch.cleanup.invalid:apply": "tsx src/backend/ops/cleanup-invalid-launch-content.ts --apply",
    "dev:reset:seed": "tsx src/backend/dev/dev-seed-reset-command.ts",
    "smoke:runtime:staging": "node scripts/runtime-staging-smoke.mjs",
    "auth:delivery:smoke": "node scripts/auth-delivery-smoke.mjs",
    "auth:bootstrap-admin": "node scripts/bootstrap-admin-account.mjs",
    "runtime-records:cleanup": "node scripts/runtime-records-cleanup.mjs",
    "runtime-records:cleanup:apply": "node scripts/runtime-records-cleanup.mjs --apply",
    "test:e2e:pg:isolated": "node scripts/e2e-pg-isolated.mjs",
    "stage:templates:validate": "node scripts/stage-templates-validate.mjs",
    "stage:templates:export": "node scripts/stage-templates-export.mjs",
    "stage:season:rotate": "node scripts/stage-season-rotate.mjs",
    "k8s:staging:local": "node scripts/k8s-local-staging.mjs",
    "k8s:staging:local:smoke": "node scripts/k8s-local-staging.mjs --run-smoke",
    "verify:launch": "node scripts/verify-launch-readiness.mjs",
    "verify:launch:ci": "node scripts/verify-launch-readiness.mjs --ci",
    "verify:launch:staging": "node scripts/verify-launch-readiness.mjs --staging --ci",
    "verify:runtime:closeout:staging": "node scripts/runtime-staging-closeout.mjs",
    "ui:build": "node scripts/ui/index.mjs build",
    "preui:check": "pnpm ui:packages:build",
    "ui:check": "node scripts/ui/index.mjs check",
    "ui:bundle:report": "node scripts/ui/report-bundle-budget.mjs",
    "ui:bundle:check": "node scripts/ui/check-bundle-budget.mjs",
    "ui:bundle:accept": "node scripts/ui/accept-bundle-baseline.mjs",
    "ui:validate": "node scripts/ui/index.mjs validate",
    "ui:tokens:build": "node scripts/ui/build-tokens-css.mjs",
    "ui:theme:web": "node scripts/ui/build-web-theme.mjs",
    "ui:theme:mobile": "node scripts/ui/build-mobile-theme.mjs",
    "ui:contract:build": "node scripts/ui/build-contract-types.mjs",
    "ui:contract:check": "node scripts/ui/check-contract-codegen-drift.mjs",
    "ui:drift:check": "node scripts/ui/check-generated-clean.mjs",
    "ui:packages:build": "node scripts/ui/build-package-dists.mjs",
    "ui:packages:check": "node scripts/ui/check-package-typecheck.mjs",
    "search:reconcile-docs": "tsx src/backend/dev/reconcile-search-docs.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/katex": "^0.16.8",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.3.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "eas-cli": "^18.1.0",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^16.4.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "shadcn": "^3.8.5",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.2.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@alicloud/dysmsapi20170525": "^4.5.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-util": "^1.4.11",
    "@aws-sdk/client-s3": "^3.1000.0",
    "@fun-forum/ui-web": "workspace:*",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@tanstack/react-query": "^5.90.21",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.16.43",
    "ky": "^1.14.3",
    "lucide-react": "^0.575.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.0",
    "nodemailer": "^8.0.4",
    "pg": "^8.18.0",
    "prisma": "^7.4.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router": "^7.13.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  }
}
