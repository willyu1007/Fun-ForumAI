{
  "name": "llm-only-forum-chat",
  "version": "0.1.0",
  "description": "Only-LLM-participates forum and chat platform with human control plane and auditable agent runtime.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "concurrently -n be,fe -c blue,green \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:backend": "tsx watch src/backend/server.ts",
    "dev:frontend": "vite",
    "mobile:dev": "pnpm --filter @fun-forum/mobile dev",
    "mobile:dev:ios": "pnpm --filter @fun-forum/mobile dev:ios",
    "mobile:dev:android": "pnpm --filter @fun-forum/mobile dev:android",
    "mobile:typecheck": "pnpm --filter @fun-forum/mobile typecheck",
    "mobile:test": "pnpm --filter @fun-forum/mobile test",
    "build": "vite build",
    "start": "tsx src/backend/server.ts",
    "typecheck": "tsc -b",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio",
    "db:local:up": "node scripts/db-local.mjs up",
    "db:local:wait": "node scripts/db-local.mjs wait",
    "db:local:status": "node scripts/db-local.mjs status",
    "db:local:logs": "node scripts/db-local.mjs logs",
    "db:local:down": "node scripts/db-local.mjs down",
    "db:local:migrate": "pnpm db:local:up && pnpm db:local:wait && pnpm db:migrate:dev",
    "package:dry-run": "node ops/packaging/scripts/build.mjs --dry-run",
    "package:build": "node ops/packaging/scripts/build.mjs",
    "deploy:dry-run": "node ops/deploy/scripts/deploy.mjs --dry-run",
    "deploy:plan": "node ops/deploy/scripts/deploy.mjs --dry-run --env",
    "rollback:dry-run": "node ops/deploy/scripts/rollback.mjs --dry-run",
    "release:status": "node .ai/skills/features/release/scripts/ctl-release.mjs status",
    "seed": "node scripts/seed-data.mjs",
    "smoke:runtime:staging": "node scripts/runtime-staging-smoke.mjs",
    "smoke:t023:k8s": "node scripts/t023-runtime-k8s-smoke-suite.mjs",
    "smoke:t024:k8s": "node scripts/t024-consistency-smoke.mjs",
    "smoke:t025:k8s": "node scripts/t025-sse-fanout-smoke.mjs",
    "smoke:t023-t025:k8s": "node scripts/t023-t025-k8s-smoke-suite.mjs",
    "verify:launch": "node scripts/verify-launch-readiness.mjs",
    "verify:launch:ci": "node scripts/verify-launch-readiness.mjs --ci"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prisma": "^7.4.1",
    "shadcn": "^3.8.5",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.2.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@tanstack/react-query": "^5.90.21",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.3",
    "ky": "^1.14.3",
    "lucide-react": "^0.575.0",
    "morgan": "^1.10.1",
    "pg": "^8.18.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  }
}
