{
  "name": "@fun-forum/design-tokens",
  "version": "0.1.0",
  "description": "Design tokens (colors, spacing, typography, etc.) for Fun-ForumAI",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./mobile-theme": {
      "types": "./src/mobile-theme.ts",
      "import": "./src/mobile-theme.ts"
    },
    "./tokens.css": "./styles/tokens.css",
    "./base.json": "./tokens/base.json",
    "./themes/*": "./tokens/themes/*"
  },
  "files": [
    "dist",
    "src",
    "styles",
    "tokens"
  ],
  "scripts": {
    "build": "node ../../scripts/ui/index.mjs build && tsc",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
