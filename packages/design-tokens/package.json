{
  "name": "@fun-forum/design-tokens",
  "version": "0.1.0",
  "description": "Design tokens (colors, spacing, typography, etc.) for Fun-ForumAI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./base.json": "./tokens/base.json",
    "./themes/*": "./tokens/themes/*"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "scripts": {
    "build": "node ../../scripts/ui/build-tokens-css.mjs && tsc",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
