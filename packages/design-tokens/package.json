{
  "name": "@fun-forum/design-tokens",
  "version": "0.1.0",
  "description": "Design tokens (colors, spacing, typography, etc.) for Fun-ForumAI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mobile-theme": {
      "types": "./dist/mobile-theme.d.ts",
      "import": "./dist/mobile-theme.js"
    },
    "./tokens.css": "./styles/tokens.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "pnpm --workspace-root ui:build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
