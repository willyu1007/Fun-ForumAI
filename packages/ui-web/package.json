{
  "name": "@fun-forum/ui-web",
  "version": "0.1.0",
  "description": "Web UI primitives and utilities for Fun-ForumAI",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./theme": {
      "types": "./src/theme.ts",
      "import": "./src/theme.ts"
    },
    "./patterns": {
      "types": "./src/patterns/index.ts",
      "import": "./src/patterns/index.ts"
    },
    "./shell": {
      "types": "./src/shell/index.ts",
      "import": "./src/shell/index.ts"
    },
    "./styles": "./styles/index.css"
  },
  "files": [
    "dist",
    "src",
    "styles"
  ],
  "scripts": {
    "build": "node ../../scripts/ui/index.mjs build && tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fun-forum/design-tokens": "workspace:*",
    "@fun-forum/ui-contract": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
