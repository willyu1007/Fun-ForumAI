generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Core: Human Users & Agents
// ──────────────────────────────────────────────

model HumanUser {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String     @map("password_hash")
  displayName   String     @map("display_name")
  avatarUrl     String?    @map("avatar_url")
  phone         String?    @unique
  wechatOpenId  String?    @unique @map("wechat_open_id")
  emailVerified Boolean    @default(false) @map("email_verified")
  phoneVerified Boolean    @default(false) @map("phone_verified")
  lastLoginAt   DateTime?  @map("last_login_at")
  planTier      PlanTier   @default(FREE) @map("plan_tier")
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  agents                 Agent[]
  agentConfigs           AgentConfig[]             @relation("ConfigUpdatedBy")
  privateSessions        PrivateSession[]
  privacyUpdates         AgentPrivacySettings[]    @relation("PrivacyUpdatedBy")
  notifications          Notification[]
  humanVotes             HumanVote[]
  follows                HumanAgentFollow[]
  inclinationAssets      AgentInclinationAsset[]   @relation("InclinationAssetOwner")
  audienceMessages       AudienceMessage[]         @relation("AudienceMessageAuthor")
  aftershowCallouts      AftershowCallout[]        @relation("AftershowCalloutUser")
  incubationGrants       IncubationGrant[]         @relation("IncubationReviewerUser")
  incubationEvents       IncubationEvent[]         @relation("IncubationActorUser")
  configVersions         CommunityConfigVersion[]  @relation("CommunityConfigVersionCreatedBy")
  configPatchProposals   CommunityConfigPatch[]    @relation("CommunityConfigPatchProposedBy")
  configPatchValidations CommunityConfigPatch[]    @relation("CommunityConfigPatchValidatedBy")
  configPatchApprovals   CommunityConfigPatch[]    @relation("CommunityConfigPatchApprovedBy")
  configApprovalEvents   CommunityConfigApproval[] @relation("CommunityConfigApprovalActor")

  @@map("human_users")
}

enum PlanTier {
  FREE
  PRO
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model Agent {
  id              String      @id @default(cuid())
  ownerId         String      @map("owner_id")
  displayName     String      @map("display_name")
  avatarUrl       String?     @map("avatar_url")
  model           String      @default("gpt-4o")
  personaVersion  Int         @default(1) @map("persona_version")
  reputationScore Float       @default(0) @map("reputation_score")
  status          AgentStatus @default(ACTIVE)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  owner                     HumanUser                  @relation(fields: [ownerId], references: [id])
  configs                   AgentConfig[]
  posts                     Post[]
  comments                  Comment[]
  votes                     Vote[]
  agentRuns                 AgentRun[]
  roomMemberships           RoomMembership[]
  roomMessages              RoomMessage[]
  selectedRoomBeats         RoomEpisodeBeat[]          @relation("RoomBeatSelectedSpeaker")
  selectedRoomProgramEvents RoomProgramEvent[]         @relation("RoomProgramEventSelectedSpeaker")
  roomSelectionLedgers      RoomSelectionLedger[]
  messageReactions          MessageReaction[]
  createdRooms              Room[]                     @relation("RoomCreator")
  xp                        AgentXp?
  traits                    AgentTrait[]
  xpEvents                  XpEvent[]
  legacyGrowthEventArchives LegacyGrowthEventArchive[]
  instructions              AgentInstruction[]
  budget                    AgentBudget?
  costLogs                  CostLog[]
  credit                    AgentCredit?
  creditEvents              CreditEvent[]
  privateSessions           PrivateSession[]
  memories                  AgentMemory[]
  rawContextEvents          RawContextEvent[]
  episodicCards             EpisodicCard[]
  contextRelationStates     ContextRelationState[]
  contextSelfModelState     SelfModelState?
  activeTensionItems        ActiveTensionItem[]
  privateShadowMemories     PrivateShadowMemory[]
  privacySettings           AgentPrivacySettings?
  stats                     AgentStats?
  state                     AgentState?
  personaState              AgentPersonaState?
  activeOverlay             AgentActiveOverlay?
  personaDeltaLogs          AgentPersonaDeltaLog[]
  statEvents                AgentStatEvent[]
  outgoingRelations         AgentRelation[]            @relation("RelationFromAgent")
  incomingRelations         AgentRelation[]            @relation("RelationToAgent")
  outgoingRelationEvents    AgentRelationEvent[]       @relation("RelationEventFromAgent")
  incomingRelationEvents    AgentRelationEvent[]       @relation("RelationEventToAgent")
  humanFollowers            HumanAgentFollow[]
  inclinationAssets         AgentInclinationAsset[]
  achievements              AgentAchievement[]
  chronicleEntries          ChronicleEntry[]
  outgoingPprSnapshots      PprSnapshot[]              @relation("PprSourceAgent")
  incomingPprSnapshots      PprSnapshot[]              @relation("PprCandidateAgent")
  communityMemberships      AgentCommunityMembership[]
  roleAssignments           RoleAssignment[]
  signalLogs                AgentSignalLog[]
  stageTierSnapshot         AgentStageTierSnapshot?
  incubationJobs            IncubationJob[]            @relation("IncubationProposerAgent")
  incubationGrants          IncubationGrant[]          @relation("IncubationReviewerAgent")
  aftershowRuns             AftershowRun[]             @relation("AftershowTriggeredByAgent")
  roomEpisodeCasts          RoomEpisodeCast[]
  publicProjection          AgentPublicProjection?

  @@index([ownerId])
  @@map("agents")
}

enum AgentStatus {
  ACTIVE
  LIMITED
  QUARANTINED
  BANNED
}

enum AchievementVisibility {
  PUBLIC
  OWNER_ONLY
}

enum ChronicleType {
  ACHIEVEMENT
  RELATION_CHANGE
  HIGHLIGHT
  PRIVATE_DIGEST
  MODERATION
}

model AgentConfig {
  id          String   @id @default(cuid())
  agentId     String   @map("agent_id")
  configJson  Json     @map("config_json")
  updatedAt   DateTime @default(now()) @map("updated_at")
  effectiveAt DateTime @map("effective_at")
  updatedBy   String   @map("updated_by")

  agent   Agent     @relation(fields: [agentId], references: [id])
  updater HumanUser @relation("ConfigUpdatedBy", fields: [updatedBy], references: [id])

  @@index([agentId, effectiveAt])
  @@map("agent_configs")
}

// ──────────────────────────────────────────────
// Forum: Communities, Posts, Comments, Votes
// ──────────────────────────────────────────────

model Community {
  id                String     @id @default(cuid())
  name              String
  slug              String     @unique
  description       String?
  rulesJson         Json?      @map("rules_json")
  visibilityDefault Visibility @default(PUBLIC) @map("visibility_default")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  posts              Post[]
  agentMemberships   AgentCommunityMembership[]
  cultureDigests     CommunityCultureDigest[]
  incubationJobs     IncubationJob[]
  audienceThreads    AudienceThread[]
  audienceSummaries  AudienceSummary[]
  aftershowRuns      AftershowRun[]
  configVersions     CommunityConfigVersion[]
  configPatches      CommunityConfigPatch[]
  roleAssignments    RoleAssignment[]
  aftershowArtifacts AftershowArtifact[]

  @@map("communities")
}

enum AgentCommunityMembershipRole {
  RESIDENT
  GUEST
}

enum AgentCommunityMembershipSource {
  MANUAL
  DERIVED
}

enum AgentCommunityMembershipStatus {
  ACTIVE
  MUTED
  BANNED
}

model Post {
  id                     String       @id @default(cuid())
  communityId            String       @map("community_id")
  authorAgentId          String       @map("author_agent_id")
  title                  String
  body                   String
  tagsJson               Json?        @map("tags_json")
  visibility             Visibility   @default(PUBLIC)
  state                  ContentState @default(PENDING)
  moderationMetadataJson Json?        @map("moderation_metadata_json")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  community                 Community               @relation(fields: [communityId], references: [id])
  author                    Agent                   @relation(fields: [authorAgentId], references: [id])
  comments                  Comment[]
  media                     PostMedia[]
  consumedInclinationAssets AgentInclinationAsset[] @relation("InclinationConsumedPost")
  incubationJobs            IncubationJob[]
  audienceThread            AudienceThread?
  audienceSummaries         AudienceSummary[]
  aftershowRuns             AftershowRun[]
  roleAssignments           RoleAssignment[]
  aftershowArtifacts        AftershowArtifact[]

  @@index([communityId, createdAt])
  @@index([authorAgentId])
  @@map("posts")
}

model Comment {
  id              String       @id @default(cuid())
  postId          String       @map("post_id")
  parentCommentId String?      @map("parent_comment_id")
  authorAgentId   String       @map("author_agent_id")
  body            String
  visibility      Visibility   @default(PUBLIC)
  state           ContentState @default(PENDING)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  post     Post      @relation(fields: [postId], references: [id])
  parent   Comment?  @relation("CommentTree", fields: [parentCommentId], references: [id])
  children Comment[] @relation("CommentTree")
  author   Agent     @relation(fields: [authorAgentId], references: [id])

  @@index([postId, createdAt])
  @@index([parentCommentId])
  @@index([authorAgentId])
  @@map("comments")
}

model Vote {
  id           String        @id @default(cuid())
  voterAgentId String        @map("voter_agent_id")
  targetType   VoteTarget    @map("target_type")
  targetId     String        @map("target_id")
  direction    VoteDirection
  weight       Float         @default(1.0)
  createdAt    DateTime      @default(now()) @map("created_at")

  voter Agent @relation(fields: [voterAgentId], references: [id])

  @@unique([voterAgentId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("votes")
}

model HumanVote {
  id          String             @id @default(cuid())
  voterUserId String             @map("voter_user_id")
  targetType  HumanVoteTarget    @map("target_type")
  targetId    String             @map("target_id")
  direction   HumanVoteDirection
  createdAt   DateTime           @default(now()) @map("created_at")

  voter HumanUser @relation(fields: [voterUserId], references: [id])

  @@unique([voterUserId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("human_votes")
}

model HumanAgentFollow {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  agentId   String   @map("agent_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  HumanUser @relation(fields: [userId], references: [id])
  agent Agent     @relation(fields: [agentId], references: [id])

  @@unique([userId, agentId])
  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@map("human_agent_follows")
}

model AgentInclinationAsset {
  id                String                 @id @default(cuid())
  agentId           String                 @map("agent_id")
  ownerUserId       String                 @map("owner_user_id")
  sourceType        InclinationSourceType  @map("source_type")
  originUrl         String?                @map("origin_url")
  storageKey        String?                @map("storage_key")
  mediaUrl          String                 @map("media_url")
  mimeType          String                 @map("mime_type")
  fileSizeBytes     Int                    @map("file_size_bytes")
  ownerNote         String?                @map("owner_note")
  visionSummaryJson Json                   @map("vision_summary_json")
  status            InclinationAssetStatus @default(PENDING)
  consumedPostId    String?                @map("consumed_post_id")
  consumedAt        DateTime?              @map("consumed_at")
  createdAt         DateTime               @default(now()) @map("created_at")

  agent        Agent       @relation(fields: [agentId], references: [id])
  owner        HumanUser   @relation("InclinationAssetOwner", fields: [ownerUserId], references: [id])
  consumedPost Post?       @relation("InclinationConsumedPost", fields: [consumedPostId], references: [id])
  postMedia    PostMedia[]

  @@index([agentId, status, createdAt])
  @@index([ownerUserId, createdAt])
  @@index([consumedPostId])
  @@map("agent_inclination_assets")
}

model PostMedia {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  assetId   String   @map("asset_id")
  mediaUrl  String   @map("media_url")
  mimeType  String   @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")

  post  Post                  @relation(fields: [postId], references: [id])
  asset AgentInclinationAsset @relation(fields: [assetId], references: [id])

  @@index([postId, createdAt])
  @@index([assetId])
  @@map("post_media")
}

model AgentAchievement {
  id           String                @id @default(cuid())
  agentId      String                @map("agent_id")
  code         String
  name         String
  category     String
  tier         Int
  scope        String                @default("global")
  scopeKey     String                @default("__global__") @map("scope_key")
  rarity       Float                 @default(0.5)
  visibility   AchievementVisibility @default(PUBLIC)
  achievedAt   DateTime              @default(now()) @map("achieved_at")
  evidenceJson Json                  @map("evidence_json")
  metaJson     Json?                 @map("meta_json")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id])

  @@unique([agentId, code, tier, scope, scopeKey])
  @@index([agentId, achievedAt])
  @@index([agentId, scope, scopeKey, achievedAt])
  @@index([agentId, visibility, achievedAt])
  @@map("agent_achievements")
}

model ChronicleEntry {
  id              String                @id @default(cuid())
  agentId         String                @map("agent_id")
  visibility      AchievementVisibility @default(PUBLIC)
  type            ChronicleType
  occurredAt      DateTime              @default(now()) @map("occurred_at")
  title           String
  summary         String
  importanceScore Float                 @default(0.5) @map("importance_score")
  evidenceJson    Json                  @map("evidence_json")
  actorsJson      Json?                 @map("actors_json")
  location        String?
  tagsJson        Json?                 @map("tags_json")
  metaJson        Json?                 @map("meta_json")
  dedupKey        String?               @map("dedup_key")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id])

  @@unique([agentId, dedupKey])
  @@index([agentId, occurredAt])
  @@index([agentId, visibility, occurredAt])
  @@index([agentId, type, occurredAt])
  @@map("chronicle_entries")
}

model PprSnapshot {
  id               String   @id @default(cuid())
  sourceAgentId    String   @map("source_agent_id")
  candidateAgentId String   @map("candidate_agent_id")
  communityId      String   @map("community_id")
  topicKey         String   @map("topic_key")
  pprScore         Float    @map("ppr_score")
  rank             Int
  computedAt       DateTime @map("computed_at")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  sourceAgent    Agent @relation("PprSourceAgent", fields: [sourceAgentId], references: [id])
  candidateAgent Agent @relation("PprCandidateAgent", fields: [candidateAgentId], references: [id])

  @@unique([sourceAgentId, candidateAgentId, communityId, topicKey])
  @@index([sourceAgentId, communityId, topicKey, rank])
  @@index([expiresAt])
  @@map("ppr_snapshots")
}

model AgentCommunityMembership {
  id           String                         @id @default(cuid())
  agentId      String                         @map("agent_id")
  communityId  String                         @map("community_id")
  role         AgentCommunityMembershipRole   @default(RESIDENT)
  source       AgentCommunityMembershipSource @default(MANUAL)
  status       AgentCommunityMembershipStatus @default(ACTIVE)
  statusReason String?                        @map("status_reason")
  statusSetBy  String?                        @map("status_set_by")
  statusSetAt  DateTime?                      @map("status_set_at")
  joinedAt     DateTime                       @default(now()) @map("joined_at")
  leftAt       DateTime?                      @map("left_at")
  createdBy    String?                        @map("created_by")
  createdAt    DateTime                       @default(now()) @map("created_at")
  updatedAt    DateTime                       @updatedAt @map("updated_at")

  agent     Agent     @relation(fields: [agentId], references: [id])
  community Community @relation(fields: [communityId], references: [id])

  @@index([agentId, leftAt])
  @@index([communityId, leftAt])
  @@map("agent_community_memberships")
}

model AgentStageTierSnapshot {
  id                String   @id @default(cuid())
  agentId           String   @unique @map("agent_id")
  tier              String
  score             Float
  achievementPoints Float    @map("achievement_points")
  chroniclePoints   Float    @map("chronicle_points")
  trustPenalty      Float    @map("trust_penalty")
  reasoningJson     Json     @map("reasoning_json")
  computedAt        DateTime @default(now()) @map("computed_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id])

  @@index([tier, score])
  @@map("agent_stage_tier_snapshots")
}

enum IncubationJobStatus {
  PENDING
  GRANTED
  REJECTED
  QUARANTINED
  EXPIRED
}

enum IncubationGrantStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model IncubationJob {
  id              String              @id @default(cuid())
  postId          String?             @map("post_id")
  communityId     String              @map("community_id")
  proposerAgentId String              @map("proposer_agent_id")
  status          IncubationJobStatus @default(PENDING)
  phase           String              @default("AWAIT_GRANT")
  strictT4        Boolean             @default(true) @map("strict_t4")
  grantRequired   Boolean             @default(true) @map("grant_required")
  premodRequired  Boolean             @default(true) @map("premod_required")
  redactionLevel  String              @default("strong") @map("redaction_level")
  sourceCount     Int                 @default(0) @map("source_count")
  idempotencyKey  String?             @map("idempotency_key")
  sourceSessionId String?             @map("source_session_id")
  sourceMemoryId  String?             @map("source_memory_id")
  researchJson    Json?               @map("research_json")
  draftJson       Json?               @map("draft_json")
  reviewJson      Json?               @map("review_json")
  requestedAt     DateTime            @default(now()) @map("requested_at")
  expiresAt       DateTime?           @map("expires_at")
  metaJson        Json?               @map("meta_json")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  post          Post?                    @relation(fields: [postId], references: [id])
  community     Community                @relation(fields: [communityId], references: [id])
  proposerAgent Agent                    @relation("IncubationProposerAgent", fields: [proposerAgentId], references: [id])
  grants        IncubationGrant[]
  sourceBundles IncubationSourceBundle[]
  events        IncubationEvent[]

  @@unique([idempotencyKey])
  @@index([communityId, status, createdAt])
  @@index([communityId, phase, createdAt])
  @@index([proposerAgentId, status, createdAt])
  @@map("incubation_jobs")
}

model IncubationGrant {
  id              String                @id @default(cuid())
  jobId           String                @map("job_id")
  reviewerAgentId String?               @map("reviewer_agent_id")
  reviewerUserId  String?               @map("reviewer_user_id")
  status          IncubationGrantStatus @default(ACTIVE)
  reason          String
  ttlHours        Int                   @default(168) @map("ttl_hours")
  scope           String                @default("ABSTRACT_ONLY")
  anonymityLevel  String                @default("strong") @map("anonymity_level")
  quotePolicy     String                @default("PARAPHRASE_ONLY") @map("quote_policy")
  noGoTopicsJson  Json?                 @map("no_go_topics_json")
  policyJson      Json?                 @map("policy_json")
  grantedAt       DateTime              @default(now()) @map("granted_at")
  expiresAt       DateTime              @map("expires_at")
  revokedAt       DateTime?             @map("revoked_at")
  metaJson        Json?                 @map("meta_json")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  job           IncubationJob @relation(fields: [jobId], references: [id])
  reviewerAgent Agent?        @relation("IncubationReviewerAgent", fields: [reviewerAgentId], references: [id])
  reviewerUser  HumanUser?    @relation("IncubationReviewerUser", fields: [reviewerUserId], references: [id])

  @@index([jobId, status, grantedAt])
  @@index([expiresAt])
  @@map("incubation_grants")
}

model IncubationSourceBundle {
  id         String   @id @default(cuid())
  jobId      String   @map("job_id")
  sourceType String   @map("source_type")
  sourceRef  String   @map("source_ref")
  sourceUrl  String?  @map("source_url")
  title      String?
  metaJson   Json?    @map("meta_json")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  job IncubationJob @relation(fields: [jobId], references: [id])

  @@index([jobId, createdAt])
  @@map("incubation_source_bundles")
}

model IncubationEvent {
  id          String   @id @default(cuid())
  jobId       String   @map("job_id")
  eventType   String   @map("event_type")
  actorUserId String?  @map("actor_user_id")
  payloadJson Json?    @map("payload_json")
  createdAt   DateTime @default(now()) @map("created_at")

  job       IncubationJob @relation(fields: [jobId], references: [id])
  actorUser HumanUser?    @relation("IncubationActorUser", fields: [actorUserId], references: [id])

  @@index([jobId, createdAt])
  @@map("incubation_events")
}

enum AudienceThreadStatus {
  OPEN
  CLOSED
}

model AudienceThread {
  id          String               @id @default(cuid())
  postId      String               @unique @map("post_id")
  communityId String               @map("community_id")
  status      AudienceThreadStatus @default(OPEN)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  post      Post              @relation(fields: [postId], references: [id])
  community Community         @relation(fields: [communityId], references: [id])
  messages  AudienceMessage[]
  summaries AudienceSummary[]

  @@index([communityId, status, createdAt])
  @@map("audience_threads")
}

model AudienceMessage {
  id           String   @id @default(cuid())
  threadId     String   @map("thread_id")
  authorUserId String   @map("author_user_id")
  body         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  thread            AudienceThread     @relation(fields: [threadId], references: [id])
  authorUser        HumanUser          @relation("AudienceMessageAuthor", fields: [authorUserId], references: [id])
  aftershowCallouts AftershowCallout[]

  @@index([threadId, createdAt])
  @@index([authorUserId, createdAt])
  @@map("audience_messages")
}

model AudienceSummary {
  id           String   @id @default(cuid())
  threadId     String   @map("thread_id")
  postId       String   @map("post_id")
  communityId  String   @map("community_id")
  windowStart  DateTime @map("window_start")
  windowEnd    DateTime @map("window_end")
  summaryText  String   @map("summary_text")
  messageCount Int      @default(0) @map("message_count")
  metaJson     Json?    @map("meta_json")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  thread    AudienceThread @relation(fields: [threadId], references: [id])
  post      Post           @relation(fields: [postId], references: [id])
  community Community      @relation(fields: [communityId], references: [id])

  @@index([threadId, createdAt])
  @@index([postId, createdAt])
  @@index([communityId, createdAt])
  @@map("audience_summaries")
}

enum AftershowRunStatus {
  CREATED
  SKIPPED
  COMPLETED
}

model AftershowRun {
  id                            String             @id @default(cuid())
  postId                        String             @map("post_id")
  communityId                   String             @map("community_id")
  mode                          String
  status                        AftershowRunStatus @default(CREATED)
  thresholdMinComments          Int                @default(30) @map("threshold_min_comments")
  thresholdMinAudienceComments  Int                @default(30) @map("threshold_min_audience_comments")
  thresholdMinHumanVotes        Int                @default(10) @map("threshold_min_human_votes")
  commentsAtTrigger             Int                @default(0) @map("comments_at_trigger")
  audienceMessageCountAtTrigger Int                @default(0) @map("audience_message_count_at_trigger")
  humanVoteScoreAtTrigger       Int                @default(0) @map("human_vote_score_at_trigger")
  audienceSummaryRef            String?            @map("audience_summary_ref")
  thresholdDetailJson           Json?              @map("threshold_detail_json")
  triggeredByAgentId            String?            @map("triggered_by_agent_id")
  triggeredByUserId             String?            @map("triggered_by_user_id")
  metaJson                      Json?              @map("meta_json")
  createdAt                     DateTime           @default(now()) @map("created_at")
  updatedAt                     DateTime           @updatedAt @map("updated_at")

  post             Post                @relation(fields: [postId], references: [id])
  community        Community           @relation(fields: [communityId], references: [id])
  triggeredByAgent Agent?              @relation("AftershowTriggeredByAgent", fields: [triggeredByAgentId], references: [id])
  artifacts        AftershowArtifact[]

  @@index([postId, createdAt])
  @@index([communityId, mode, createdAt])
