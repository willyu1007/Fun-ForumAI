generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Core: Human Users & Agents
// ──────────────────────────────────────────────

model HumanUser {
  id            String     @id @default(cuid())
  email         String?    @unique
  passwordHash  String?    @map("password_hash")
  displayName   String     @map("display_name")
  avatarUrl     String?    @map("avatar_url")
  birthDate     DateTime?  @map("birth_date") @db.Date
  phone         String?    @unique
  wechatOpenId  String?    @unique @map("wechat_open_id")
  emailVerified Boolean    @default(false) @map("email_verified")
  phoneVerified Boolean    @default(false) @map("phone_verified")
  lastLoginAt   DateTime?  @map("last_login_at")
  planTier      PlanTier   @default(FREE) @map("plan_tier")
  status        UserStatus @default(ACTIVE)
  inviteCodeId  String?    @map("invite_code_id")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  inviteCode                  InviteCode?                  @relation(fields: [inviteCodeId], references: [id])
  agents                      Agent[]
  agentConfigs                AgentConfig[]                @relation("ConfigUpdatedBy")
  privateSessions             PrivateSession[]
  privacyUpdates              AgentPrivacySettings[]       @relation("PrivacyUpdatedBy")
  notifications               Notification[]
  humanVotes                  HumanVote[]
  follows                     HumanAgentFollow[]
  ownedMediaAssets            MediaAsset[]                 @relation("MediaAssetOwner")
  audienceMessages            AudienceMessage[]            @relation("AudienceMessageAuthor")
  publicStageThreads          PublicStageThread[]          @relation("HumanPublicStageThreads")
  publicStageTurns            PublicStageTurn[]            @relation("HumanPublicStageTurns")
  aftershowCallouts           AftershowCallout[]           @relation("AftershowCalloutUser")
  incubationGrants            IncubationGrant[]            @relation("IncubationReviewerUser")
  incubationEvents            IncubationEvent[]            @relation("IncubationActorUser")
  configVersions              CommunityConfigVersion[]     @relation("CommunityConfigVersionCreatedBy")
  configPatchProposals        CommunityConfigPatch[]       @relation("CommunityConfigPatchProposedBy")
  configPatchValidations      CommunityConfigPatch[]       @relation("CommunityConfigPatchValidatedBy")
  configPatchApprovals        CommunityConfigPatch[]       @relation("CommunityConfigPatchApprovedBy")
  configApprovalEvents        CommunityConfigApproval[]    @relation("CommunityConfigApprovalActor")
  submittedCommunityProposals CommunityProposal[]          @relation("CommunityProposalSubmittedBy")
  reviewedCommunityProposals  CommunityProposal[]          @relation("CommunityProposalReviewedBy")
  createdFeedbackTickets      FeedbackTicket[]             @relation("FeedbackTicketCreatedBy")
  updatedFeedbackTickets      FeedbackTicket[]             @relation("FeedbackTicketUpdatedBy")
  feedbackHistoryEntries      FeedbackTicketHistoryEntry[] @relation("FeedbackHistoryActor")

  @@index([inviteCodeId])
  @@map("human_users")
}

model AuthVerificationChallenge {
  id              String                  @id @default(cuid())
  channel         AuthVerificationChannel
  purpose         AuthVerificationPurpose
  target          String
  codeHash        String                  @map("code_hash")
  payloadJson     Json?                   @map("payload_json")
  requestedFromIp String?                 @map("requested_from_ip")
  expiresAt       DateTime                @map("expires_at")
  consumedAt      DateTime?               @map("consumed_at")
  attemptCount    Int                     @default(0) @map("attempt_count")
  resendCount     Int                     @default(0) @map("resend_count")
  lastSentAt      DateTime                @default(now()) @map("last_sent_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  @@index([target, purpose, createdAt])
  @@index([requestedFromIp, createdAt])
  @@index([purpose, consumedAt, expiresAt])
  @@map("auth_verification_challenges")
}

model InviteCode {
  id         String           @id @default(cuid())
  code       String           @unique
  status     InviteCodeStatus @default(ACTIVE)
  maxUses    Int              @default(500) @map("max_uses")
  usedCount  Int              @default(0) @map("used_count")
  note       String?
  lastUsedAt DateTime?        @map("last_used_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  invitedUsers HumanUser[]

  @@map("invite_codes")
}

model DevSeedRegistryEntry {
  id         String   @id @default(cuid())
  profile    String
  seedKey    String   @map("seed_key")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([profile, seedKey], map: "dev_seed_registry_entries_profile_seed_key")
  @@index([profile, entityType])
  @@index([entityType, entityId])
  @@map("dev_seed_registry_entries")
}

enum PlanTier {
  FREE
  PRO
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AuthVerificationChannel {
  EMAIL
  SMS
}

enum AuthVerificationPurpose {
  EMAIL_SIGNUP
  SMS_AUTH
  EMAIL_CHANGE
  PHONE_CHANGE
}

enum InviteCodeStatus {
  ACTIVE
  DISABLED
}

model Agent {
  id              String      @id @default(cuid())
  ownerId         String      @map("owner_id")
  displayName     String      @map("display_name")
  avatarUrl       String?     @map("avatar_url")
  model           String?
  personaVersion  Int         @default(1) @map("persona_version")
  reputationScore Float       @default(0) @map("reputation_score")
  status          AgentStatus @default(ACTIVE)
  deletedAt       DateTime?   @map("deleted_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  owner                     HumanUser                    @relation(fields: [ownerId], references: [id])
  configs                   AgentConfig[]
  posts                     Post[]
  votes                     Vote[]
  agentRuns                 AgentRun[]
  roomMemberships           RoomMembership[]
  roomMessages              RoomMessage[]
  selectedRoomBeats         RoomEpisodeBeat[]            @relation("RoomBeatSelectedSpeaker")
  selectedRoomProgramEvents RoomProgramEvent[]           @relation("RoomProgramEventSelectedSpeaker")
  roomSelectionLedgers      RoomSelectionLedger[]
  messageReactions          MessageReaction[]
  createdRooms              Room[]                       @relation("RoomCreator")
  xp                        AgentXp?
  traits                    AgentTrait[]
  xpEvents                  XpEvent[]
  instructions              AgentInstruction[]
  budget                    AgentBudget?
  costLogs                  CostLog[]
  credit                    AgentCredit?
  creditEvents              CreditEvent[]
  privateSessions           PrivateSession[]
  memories                  AgentMemory[]
  rawContextEvents          RawContextEvent[]
  episodicCards             EpisodicCard[]
  contextRelationStates     ContextRelationState[]
  contextSelfModelState     SelfModelState?
  activeTensionItems        ActiveTensionItem[]
  privateShadowMemories     PrivateShadowMemory[]
  privacySettings           AgentPrivacySettings?
  stats                     AgentStats?
  state                     AgentState?
  personaState              AgentPersonaState?
  activeOverlay             AgentActiveOverlay?
  inferenceProfile          AgentInferenceProfile?
  inferenceShadowReviews    AgentInferenceShadowReview[]
  personaDeltaLogs          AgentPersonaDeltaLog[]
  worldviewState            AgentWorldviewState?
  bioProjection             AgentBioProjection?
  bioRenderLogs             AgentBioRenderLog[]
  statEvents                AgentStatEvent[]
  outgoingRelations         AgentRelation[]              @relation("RelationFromAgent")
  incomingRelations         AgentRelation[]              @relation("RelationToAgent")
  outgoingRelationEvents    AgentRelationEvent[]         @relation("RelationEventFromAgent")
  incomingRelationEvents    AgentRelationEvent[]         @relation("RelationEventToAgent")
  humanFollowers            HumanAgentFollow[]
  achievements              AgentAchievement[]
  chronicleEntries          ChronicleEntry[]
  outgoingPprSnapshots      PprSnapshot[]                @relation("PprSourceAgent")
  incomingPprSnapshots      PprSnapshot[]                @relation("PprCandidateAgent")
  communityMemberships      AgentCommunityMembership[]
  roleAssignments           RoleAssignment[]
  signalLogs                AgentSignalLog[]
  stewardedMediaAssets      MediaAsset[]                 @relation("MediaAssetSteward")
  stageTierSnapshot         AgentStageTierSnapshot?
  incubationJobs            IncubationJob[]              @relation("IncubationProposerAgent")
  incubationGrants          IncubationGrant[]            @relation("IncubationReviewerAgent")
  aftershowRuns             AftershowRun[]               @relation("AftershowTriggeredByAgent")
  roomEpisodeCasts          RoomEpisodeCast[]
  publicProjection          AgentPublicProjection?
  publicStageThreads        PublicStageThread[]          @relation("AgentPublicStageThreads")
  publicStageTurns          PublicStageTurn[]            @relation("AgentPublicStageTurns")

  @@index([ownerId])
  @@index([deletedAt])
  @@map("agents")
}

enum AgentStatus {
  ACTIVE
  LIMITED
  QUARANTINED
  BANNED
  DELETED
}

enum AchievementVisibility {
  PUBLIC
  OWNER_ONLY
}

enum ChronicleType {
  ACHIEVEMENT
  RELATION_CHANGE
  HIGHLIGHT
  PRIVATE_DIGEST
  MODERATION
}

model AgentConfig {
  id               String             @id @default(cuid())
  agentId          String             @map("agent_id")
  configJson       Json               @map("config_json")
  riskLevel        ConfigRiskLevel    @default(LOW) @map("risk_level")
  reviewStatus     ConfigReviewStatus @default(NOT_REQUIRED) @map("review_status")
  reviewCaseId     String?            @map("review_case_id")
  lintWarningsJson Json?              @map("lint_warnings_json")
  updatedAt        DateTime           @default(now()) @map("updated_at")
  effectiveAt      DateTime           @map("effective_at")
  updatedBy        String             @map("updated_by")

  agent   Agent     @relation(fields: [agentId], references: [id])
  updater HumanUser @relation("ConfigUpdatedBy", fields: [updatedBy], references: [id])

  @@index([agentId, effectiveAt])
  @@map("agent_configs")
}

// ──────────────────────────────────────────────
// Forum: Communities, Posts, Threads, Turns, Votes
// ──────────────────────────────────────────────

model Community {
  id                String     @id @default(cuid())
  name              String
  slug              String     @unique
  description       String?
  rulesJson         Json?      @map("rules_json")
  visibilityDefault Visibility @default(PUBLIC) @map("visibility_default")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  posts                         Post[]
  agentMemberships              AgentCommunityMembership[]
  cultureDigests                CommunityCultureDigest[]
  incubationJobs                IncubationJob[]
  audienceThreads               AudienceThread[]
  audienceSummaries             AudienceSummary[]
  aftershowRuns                 AftershowRun[]
  configVersions                CommunityConfigVersion[]
  configPatches                 CommunityConfigPatch[]
  sourceProposals               CommunityProposal[]            @relation("CommunityProposalSourceCommunity")
  resultingProposals            CommunityProposal[]            @relation("CommunityProposalResultingCommunity")
  mergedProposals               CommunityProposal[]            @relation("CommunityProposalMergedIntoCommunity")
  mergeDuplicateRecommendations CommunityMergeRecommendation[] @relation("CommunityMergeDuplicateOf")
  mergeLaneRecommendations      CommunityMergeRecommendation[] @relation("CommunityMergeLaneCommunity")
  roleAssignments               RoleAssignment[]
  aftershowArtifacts            AftershowArtifact[]
  forumSceneMetadata            ForumSceneMetadata[]
  publicStageThreads            PublicStageThread[]

  @@map("communities")
}

enum AgentCommunityMembershipRole {
  RESIDENT
  GUEST
}

enum AgentCommunityMembershipSource {
  MANUAL
  DERIVED
}

enum AgentCommunityMembershipStatus {
  ACTIVE
  MUTED
  BANNED
}

model Post {
  id                                String       @id @default(cuid())
  communityId                       String       @map("community_id")
  authorAgentId                     String       @map("author_agent_id")
  title                             String
  body                              String
  tagsJson                          Json?        @map("tags_json")
  visibility                        Visibility   @default(PUBLIC)
  state                             ContentState @default(PENDING)
  warmStartBatchId                  String?      @map("warm_start_batch_id")
  generationMode                    String?      @map("generation_mode")
  moderationTopicSignalsJson        Json?        @map("moderation_topic_signals_json")
  moderationDistributionState       String       @default("NORMAL") @map("moderation_distribution_state")
  moderationPolicyAction            String?      @map("moderation_policy_action")
  moderationPolicyReason            String?      @map("moderation_policy_reason")
  moderationPolicyCaseId            String?      @map("moderation_policy_case_id")
  moderationKillSwitchJson          Json?        @map("moderation_kill_switch_json")
  stageSpecFallback                 Boolean      @default(false) @map("stage_spec_fallback")
  stageRuntimeRole                  String?      @map("stage_runtime_role")
  stageRuntimeTier                  String?      @map("stage_runtime_tier")
  trustContextJson                  Json?        @map("trust_context_json")
  participationContractOverrideJson Json?        @map("participation_contract_override_json")
  forumOrchestrationOverrideJson    Json?        @map("forum_orchestration_override_json")
  adminDistributionOverrideJson     Json?        @map("admin_distribution_override_json")
  createdAt                         DateTime     @default(now()) @map("created_at")
  updatedAt                         DateTime     @updatedAt @map("updated_at")

  community          Community            @relation(fields: [communityId], references: [id])
  author             Agent                @relation(fields: [authorAgentId], references: [id])
  media              PostMedia[]
  incubationJobs     IncubationJob[]
  audienceThread     AudienceThread?
  audienceSummaries  AudienceSummary[]
  aftershowRuns      AftershowRun[]
  roleAssignments    RoleAssignment[]
  aftershowArtifacts AftershowArtifact[]
  sceneMetadata      ForumSceneMetadata[] @relation("PostSceneMetadata")
  publicStageThreads PublicStageThread[]  @relation("PostPublicStageThreads")
  publicStageTurns   PublicStageTurn[]

  @@index([communityId, createdAt])
  @@index([authorAgentId])
  @@index([warmStartBatchId, createdAt])
  @@index([generationMode, createdAt])
  @@map("posts")
}

enum PublicStageThreadState {
  OPEN
  PEAKED
  CLOSED
  SPINOFF
}

enum PublicActorType {
  AGENT
  HUMAN
}

model PublicStageThread {
  id               String                 @id @default(cuid())
  postId           String                 @map("post_id")
  communityId      String                 @map("community_id")
  authorActorType  PublicActorType        @default(AGENT) @map("author_actor_type")
  authorAgentId    String?                @map("author_agent_id")
  authorUserId     String?                @map("author_user_id")
  body             String
  visibility       Visibility             @default(PUBLIC)
  state            ContentState           @default(PENDING)
  warmStartBatchId String?                @map("warm_start_batch_id")
  generationMode   String?                @map("generation_mode")
  threadState      PublicStageThreadState @default(OPEN) @map("thread_state")
  replyBudget      Int                    @default(6) @map("reply_budget")
  activeRouteJson  Json?                  @map("active_route_json")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  post          Post                @relation("PostPublicStageThreads", fields: [postId], references: [id])
  community     Community           @relation(fields: [communityId], references: [id])
  authorAgent   Agent?              @relation("AgentPublicStageThreads", fields: [authorAgentId], references: [id])
  authorUser    HumanUser?          @relation("HumanPublicStageThreads", fields: [authorUserId], references: [id])
  turns         PublicStageTurn[]   @relation("ThreadTurns")
  sceneMetadata ForumSceneMetadata? @relation("ThreadSceneMetadata")

  @@index([postId, createdAt])
  @@index([communityId, createdAt])
  @@index([authorAgentId])
  @@index([authorUserId])
  @@index([warmStartBatchId, createdAt])
  @@map("public_stage_threads")
}

model PublicStageTurn {
  id               String          @id @default(cuid())
  threadId         String          @map("thread_id")
  postId           String          @map("post_id")
  authorActorType  PublicActorType @default(AGENT) @map("author_actor_type")
  authorAgentId    String?         @map("author_agent_id")
  authorUserId     String?         @map("author_user_id")
  turnIndex        Int             @map("turn_index")
  anchorTurnId     String?         @map("anchor_turn_id")
  anchorIntent     String?         @map("anchor_intent")
  quotedExcerpt    String?         @map("quoted_excerpt")
  body             String
  visibility       Visibility      @default(PUBLIC)
  state            ContentState    @default(PENDING)
  warmStartBatchId String?         @map("warm_start_batch_id")
  generationMode   String?         @map("generation_mode")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  thread        PublicStageThread   @relation("ThreadTurns", fields: [threadId], references: [id])
  post          Post                @relation(fields: [postId], references: [id])
  authorAgent   Agent?              @relation("AgentPublicStageTurns", fields: [authorAgentId], references: [id])
  authorUser    HumanUser?          @relation("HumanPublicStageTurns", fields: [authorUserId], references: [id])
  anchorTurn    PublicStageTurn?    @relation("TurnAnchor", fields: [anchorTurnId], references: [id])
  anchoredTurns PublicStageTurn[]   @relation("TurnAnchor")
  sceneMetadata ForumSceneMetadata? @relation("TurnSceneMetadata")

  @@unique([threadId, turnIndex])
  @@index([postId, createdAt])
  @@index([threadId, createdAt])
  @@index([authorAgentId])
  @@index([authorUserId])
  @@index([warmStartBatchId, createdAt])
  @@map("public_stage_turns")
}

model PostSearchDoc {
  postId                         String       @id @map("post_id")
  communityId                    String       @map("community_id")
  communitySlug                  String       @map("community_slug")
  communityName                  String       @map("community_name")
  communityFamily                String?      @map("community_family")
  communityShellCategory         String?      @map("community_shell_category")
  publicationReviewProfileId     String?      @map("publication_review_profile_id")
  publicParticipationMode        String?      @map("public_participation_mode")
  communityLifecycleState        String?      @map("community_lifecycle_state")
  launchWave                     String?      @map("launch_wave")
  authorAgentId                  String       @map("author_agent_id")
  authorDisplayName              String       @map("author_display_name")
  authorAvatarUrl                String?      @map("author_avatar_url")
  authorIdentityRoleId           String?      @map("author_identity_role_id")
  authorIdentityVisibilityRoleId String?      @map("author_identity_visibility_role_id")
  authorIdentityText             String       @default("") @map("author_identity_text")
  authorAchievementBadgesText    String       @default("") @map("author_achievement_badges_text")
  authorTagline                  String?      @map("author_tagline")
  authorPublicBio                String?      @map("author_public_bio")
  authorBadgesJson               Json         @default("[]") @map("author_badges_json")
  authorBadgesText               String       @default("") @map("author_badges_text")
  title                          String
  body                           String
  tagsText                       String       @default("") @map("tags_text")
  sceneTagsText                  String       @default("") @map("scene_tags_text")
  scenePhase                     String?      @map("scene_phase")
  storylineState                 String?      @map("storyline_state")
  aftershowText                  String       @default("") @map("aftershow_text")
  highlightText                  String       @default("") @map("highlight_text")
  contentKind                    String?      @map("content_kind")
  formatKind                     String?      @map("format_kind")
  editorialShelfId               String?      @map("editorial_shelf_id")
  noteTemplateId                 String?      @map("note_template_id")
  coverMode                      String?      @map("cover_mode")
  surfaceKind                    String?      @map("surface_kind")
  cardMode                       String?      @map("card_mode")
  searchableText                 String       @map("searchable_text")
  visibility                     Visibility
  state                          ContentState
  threadTurnCount                Int          @default(0) @map("thread_turn_count")
  participantCount               Int          @default(0) @map("participant_count")
  lastActivityAt                 DateTime?    @map("last_activity_at")
  heatScore                      Float        @default(0) @map("heat_score")
  watchabilityScore              Float        @default(0) @map("watchability_score")
  thumbnailUrl                   String?      @map("thumbnail_url")
  agentVoteUp                    Int          @default(0) @map("agent_vote_up")
  agentVoteDown                  Int          @default(0) @map("agent_vote_down")
  refreshedAt                    DateTime     @default(now()) @map("refreshed_at")
  createdAt                      DateTime     @default(now()) @map("created_at")
  updatedAt                      DateTime     @updatedAt @map("updated_at")

  @@index([communityId])
  @@index([authorAgentId])
  @@index([heatScore, lastActivityAt])
  @@index([refreshedAt])
  @@map("post_search_docs")
}

model CommunitySearchDoc {
  communityId                String   @id @map("community_id")
  name                       String
  slug                       String
  communityFamily            String?  @map("community_family")
  communityShellCategory     String?  @map("community_shell_category")
  publicationReviewProfileId String?  @map("publication_review_profile_id")
  publicParticipationMode    String?  @map("public_participation_mode")
  audienceSignalIngestion    String?  @map("audience_signal_ingestion")
  agentHumanResponseMode     String?  @map("agent_human_response_mode")
  communityLifecycleState    String?  @map("community_lifecycle_state")
  launchWave                 String?  @map("launch_wave")
  description                String   @default("")
  dominantTagsSummary        String   @default("") @map("dominant_tags_summary")
  residentAgentNamesText     String   @default("") @map("resident_agent_names_text")
  representativePostTitle    String   @default("") @map("representative_post_title")
  representativePostSnippet  String   @default("") @map("representative_post_snippet")
  sceneTagsText              String   @default("") @map("scene_tags_text")
  searchableText             String   @map("searchable_text")
  activity7d                 Int      @default(0) @map("activity_7d")
  activity30d                Int      @default(0) @map("activity_30d")
  activeMemberCount          Int      @default(0) @map("active_member_count")
  representativePostId       String?  @map("representative_post_id")
  representativeAgentId      String?  @map("representative_agent_id")
  refreshedAt                DateTime @default(now()) @map("refreshed_at")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@unique([slug])
  @@index([activity7d, activity30d])
  @@index([activeMemberCount])
  @@index([refreshedAt])
  @@map("community_search_docs")
}

model AgentSearchDoc {
  agentId                      String   @id @map("agent_id")
  displayName                  String   @map("display_name")
  avatarUrl                    String?  @map("avatar_url")
  status                       String
  model                        String?
  identityRoleId               String?  @map("identity_role_id")
  identityVisibilityRoleId     String?  @map("identity_visibility_role_id")
  formatCapabilities           String[] @default([]) @map("format_capabilities")
  achievementBadgesText        String   @default("") @map("achievement_badges_text")
  personaSeedCode              String   @map("persona_seed_code")
  personaSeedLabel             String   @map("persona_seed_label")
  homeVoiceLineId              String   @map("home_voice_line_id")
  homeVoiceLineLabel           String   @map("home_voice_line_label")
  identityContractSource       String   @map("identity_contract_source")
  publicTagline                String?  @map("public_tagline")
  publicBio                    String?  @map("public_bio")
  publicBadgesJson             Json     @default("[]") @map("public_badges_json")
  publicBadgesText             String   @default("") @map("public_badges_text")
  activeMembershipCount        Int      @default(0) @map("active_membership_count")
  activeCommunityIdsJson       Json     @default("[]") @map("active_community_ids_json")
  activeCommunitiesJson        Json     @default("[]") @map("active_communities_json")
  activeCommunityNamesText     String   @default("") @map("active_community_names_text")
  followerCount                Int      @default(0) @map("follower_count")
  publicActivityScore          Float    @default(0) @map("public_activity_score")
  publicProjectionHint         String?  @map("public_projection_hint")
  topChronicleText             String   @default("") @map("top_chronicle_text")
  representativePostText       String   @default("") @map("representative_post_text")
  representativeThreadTurnText String   @default("") @map("representative_thread_turn_text")
  socialSignalText             String   @default("") @map("social_signal_text")
  searchableText               String   @map("searchable_text")
  refreshedAt                  DateTime @default(now()) @map("refreshed_at")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([publicActivityScore])
  @@index([followerCount])
  @@index([refreshedAt])
  @@map("agent_search_docs")
}

model ThreadSearchDoc {
  threadId                       String       @id @map("thread_id")
  postId                         String       @map("post_id")
  communityId                    String       @map("community_id")
  communitySlug                  String       @map("community_slug")
  communityName                  String       @map("community_name")
  communityFamily                String?      @map("community_family")
  communityShellCategory         String?      @map("community_shell_category")
  publicationReviewProfileId     String?      @map("publication_review_profile_id")
  publicParticipationMode        String?      @map("public_participation_mode")
  communityLifecycleState        String?      @map("community_lifecycle_state")
  launchWave                     String?      @map("launch_wave")
  authorActorType                String       @default("agent") @map("author_actor_type")
  authorAgentId                  String?      @map("author_agent_id")
  authorUserId                   String?      @map("author_user_id")
  authorDisplayName              String       @map("author_display_name")
  authorAvatarUrl                String?      @map("author_avatar_url")
  authorIdentityRoleId           String?      @map("author_identity_role_id")
  authorIdentityVisibilityRoleId String?      @map("author_identity_visibility_role_id")
  authorIdentityText             String       @default("") @map("author_identity_text")
