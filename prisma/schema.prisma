  FREE_CHAT
  TALK_SHOW
  ROUND_TABLE
  ROAST
  DEBATE
  SLICE_OF_LIFE
  STORY_LAB
}

enum RoomEpisodeStatus {
  ACTIVE
  ENDED
}

enum RoomCastRole {
  HOST
  REGULAR
  FOIL
  SKEPTIC
  EXPLAINER
  WILDCARD
  CHRONICLER
}

enum RoomBeatType {
  OPENING
  HOOK
  EXPLAIN
  CLASH
  CALLBACK
  COOL_DOWN
  RECAP
  LANDING
}

enum RoomCueType {
  ADVANCE
  ASK
  CALLBACK
  SUMMARIZE
  COOL_DOWN
  CLOSE
}

enum RoomProgramEventType {
  RAW_MESSAGE
  ROOM_TICK
  PROGRAM_CUE
}

enum RoomProgramEventStatus {
  PENDING
  PLANNED
  EXECUTED
  SKIPPED
  FAILED
}

enum RoomHighlightKind {
  CALLBACK
  PUNCHLINE
  CHARACTER_MOMENT
  SUMMARY
  CLASH
}

model RoomProgram {
  id                         String        @id @default(cuid())
  roomId                     String        @unique @map("room_id")
  enabled                    Boolean       @default(false)
  sceneType                  RoomSceneType @default(FREE_CHAT) @map("scene_type")
  pacingPreset               String        @default("balanced") @map("pacing_preset")
  targetCastMin              Int           @default(3) @map("target_cast_min")
  targetCastMax              Int           @default(5) @map("target_cast_max")
  callbackWindow             Int           @default(18) @map("callback_window")
  recapEveryTurns            Int           @default(10) @map("recap_every_turns")
  maxConsecutiveTurns        Int           @default(1) @map("max_consecutive_turns")
  idleCueAfterMs             Int           @default(30000) @map("idle_cue_after_ms")
  allowWandering             Boolean       @default(true) @map("allow_wandering")
  directorPolicyJson         Json          @default("{}") @map("director_policy_json")
  wanderPolicyJson           Json          @default("{}") @map("wander_policy_json")
  discoverabilityTags        Json          @default("[]") @map("discoverability_tags")
  discoverabilityShortHook   String?       @map("discoverability_short_hook") @db.Text
  discoverabilityDefaultView String        @default("live") @map("discoverability_default_view")
  createdAt                  DateTime      @default(now()) @map("created_at")
  updatedAt                  DateTime      @updatedAt @map("updated_at")

  room     Room          @relation(fields: [roomId], references: [id])
  episodes RoomEpisode[]

  @@map("room_programs")
}

model RoomEpisode {
  id                 String            @id @default(cuid())
  roomId             String            @map("room_id")
  programId          String            @map("program_id")
  status             RoomEpisodeStatus @default(ACTIVE)
  summaryText        String            @default("") @map("summary_text") @db.Text
  unresolvedQuestion String?           @map("unresolved_question") @db.Text
  callbackBankJson   Json              @default("[]") @map("callback_bank_json")
  energy             Float             @default(0)
  tension            Float             @default(0)
  turnCount          Int               @default(0) @map("turn_count")
  messageCount       Int               @default(0) @map("message_count")
  startedAt          DateTime          @default(now()) @map("started_at")
  endedAt            DateTime?         @map("ended_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  room           Room                  @relation(fields: [roomId], references: [id])
  program        RoomProgram           @relation(fields: [programId], references: [id])
  casts          RoomEpisodeCast[]
  beats          RoomEpisodeBeat[]
  events         RoomProgramEvent[]
  ledgers        RoomSelectionLedger[]
  highlights     RoomHighlight[]
  snapshots      RoomLiveSnapshot[]
  messages       RoomMessage[]
  sharedMemories RoomSharedMemory[]

  @@index([roomId, status])
  @@map("room_episodes")
}

model RoomEpisodeCast {
  id              String       @id @default(cuid())
  roomId          String       @map("room_id")
  episodeId       String       @map("episode_id")
  agentId         String       @map("agent_id")
  role            RoomCastRole
  entrySource     String       @default("projector") @map("entry_source")
  chemistryScore  Float        @default(0) @map("chemistry_score")
  spotlightWeight Float        @default(1) @map("spotlight_weight")
  joinedAt        DateTime     @default(now()) @map("joined_at")
  leftAt          DateTime?    @map("left_at")

  room    Room        @relation(fields: [roomId], references: [id])
  episode RoomEpisode @relation(fields: [episodeId], references: [id])
  agent   Agent       @relation(fields: [agentId], references: [id])

  @@unique([episodeId, agentId])
  @@index([roomId, episodeId])
  @@map("room_episode_casts")
}

model RoomEpisodeBeat {
  id                     String        @id @default(cuid())
  roomId                 String        @map("room_id")
  episodeId              String        @map("episode_id")
  ordinal                Int
  beatType               RoomBeatType  @map("beat_type")
  cueType                RoomCueType   @map("cue_type")
  directorGoal           String        @map("director_goal") @db.Text
  promptHint             String?       @map("prompt_hint") @db.Text
  anchorMessageId        String?       @map("anchor_message_id")
  callbackMessageId      String?       @map("callback_message_id")
  targetRole             RoomCastRole? @map("target_role")
  selectedSpeakerAgentId String?       @map("selected_speaker_agent_id")
  status                 String        @default("planned")
  auditJson              Json?         @map("audit_json")
  createdAt              DateTime      @default(now()) @map("created_at")
  completedAt            DateTime?     @map("completed_at")

