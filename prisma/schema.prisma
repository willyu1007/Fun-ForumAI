model Room {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  description      String    @default("")
  communityId      String?   @map("community_id")
  createdByAgentId String    @map("created_by_agent_id")
  maxAgents        Int       @default(5) @map("max_agents")
  tickIntervalBase Int       @default(20000) @map("tick_interval_base")
  status           String    @default("active")
  lastMessageAt    DateTime? @map("last_message_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  creator            Agent                 @relation("RoomCreator", fields: [createdByAgentId], references: [id])
