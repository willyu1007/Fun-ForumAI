  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  actorUserId String   @map("actor_user_id")
  reason      String?  @db.Text
  resultJson  Json?    @map("result_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([caseId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("governance_action_logs")
}

model ComplaintTicket {
  id              String          @id @default(cuid())
  reporterUserId  String          @map("reporter_user_id")
  targetType      String          @map("target_type")
  targetId        String          @map("target_id")
  complaintType   ComplaintType   @default(CONTENT_REPORT) @map("complaint_type")
  reasonCode      String          @map("reason_code")
  detailText      String?         @map("detail_text") @db.Text
  attachmentsJson Json            @default("[]") @map("attachments_json")
  status          ComplaintStatus @default(OPEN)
  linkedCaseId    String?         @map("linked_case_id")
  resolutionJson  Json?           @map("resolution_json")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([reporterUserId, createdAt])
  @@map("complaint_tickets")
}

model AppealRequest {
  id                      String              @id @default(cuid())
  requesterUserId         String              @map("requester_user_id")
  requesterType           AppealRequesterType @default(USER) @map("requester_type")
  targetType              String              @map("target_type")
  targetId                String              @map("target_id")
  appealType              AppealType          @default(CONTENT_APPEAL) @map("appeal_type")
  linkedCaseId            String?             @map("linked_case_id")
  linkedComplaintTicketId String?             @map("linked_complaint_ticket_id")
  reason                  String              @db.Text
  status                  AppealStatus        @default(OPEN)
  resultJson              Json?               @map("result_json")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([requesterUserId, createdAt])
  @@map("appeal_requests")
}

model RiskEventLog {
  id               String   @id @default(cuid())
  policySnapshotId String?  @map("policy_snapshot_id")
  caseId           String?  @map("case_id")
  channel          String
  eventType        String   @map("event_type")
  action           String
  riskLevel        String?  @map("risk_level")
  riskScore        Float?   @map("risk_score")
  riskCategories   Json?    @default("[]") @map("risk_categories")
  targetType       String?  @map("target_type")
  targetId         String?  @map("target_id")
  communityId      String?  @map("community_id")
  agentId          String?  @map("agent_id")
  userId           String?  @map("user_id")
  roomId           String?  @map("room_id")
  sessionId        String?  @map("session_id")
  messageId        String?  @map("message_id")
  detailText       String?  @map("detail_text") @db.Text
  payloadJson      Json?    @map("payload_json")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([channel, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([agentId, createdAt])
  @@index([userId, createdAt])
  @@map("risk_event_logs")
}

model PublicDisclosureCapOverride {
  id                String                            @id @default(cuid())
  scopeType         DisclosureCapScopeType            @map("scope_type")
  scopeId           String                            @map("scope_id")
  capLevel          Int                               @map("cap_level")
  status            PublicDisclosureCapOverrideStatus @default(ACTIVE)
  source            PublicDisclosureCapOverrideSource
  reason            String?                           @db.Text
  linkedCaseId      String?                           @map("linked_case_id")
  linkedRiskEventId String?                           @map("linked_risk_event_id")
  createdByUserId   String                            @map("created_by_user_id")
  releasedByUserId  String?                           @map("released_by_user_id")
  releasedReason    String?                           @map("released_reason") @db.Text
  releasedAt        DateTime?                         @map("released_at")
  createdAt         DateTime                          @default(now()) @map("created_at")

  // Active-row uniqueness is enforced by a partial unique index in SQL migration.
  @@index([scopeType, scopeId, status, createdAt])
  @@index([status, createdAt])
  @@index([linkedCaseId, createdAt])
  @@index([linkedRiskEventId, createdAt])
  @@map("public_disclosure_cap_overrides")
}

