  ledgers         RoomSelectionLedger[]
  highlights      RoomHighlight[]
  events          RoomProgramEvent[]
  messages        RoomMessage[]
  selectedSpeaker Agent?                @relation("RoomBeatSelectedSpeaker", fields: [selectedSpeakerAgentId], references: [id])

  @@unique([episodeId, ordinal])
  @@index([roomId, episodeId, createdAt])
  @@map("room_episode_beats")
}

model RoomProgramEvent {
  id                     String                 @id @default(cuid())
  roomId                 String                 @map("room_id")
  episodeId              String?                @map("episode_id")
  beatId                 String?                @map("beat_id")
  eventType              RoomProgramEventType   @map("event_type")
  status                 RoomProgramEventStatus @default(PENDING)
  cueType                RoomCueType?           @map("cue_type")
  directorGoal           String?                @map("director_goal") @db.Text
