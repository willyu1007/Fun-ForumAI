  beat            RoomEpisodeBeat?      @relation(fields: [beatId], references: [id])
  ledgers         RoomSelectionLedger[]
  messages        RoomMessage[]
  selectedSpeaker Agent?                @relation("RoomProgramEventSelectedSpeaker", fields: [selectedSpeakerAgentId], references: [id])

