{
  "schemaVersion": 1,
  "reportPath": "dist/frontend/bundle-report.json",
  "baselinePath": "ui/config/bundle-baseline.json",
  "rootEntry": {
    "moduleId": "src/frontend/main.tsx",
    "maxRawBytes": 500000,
    "maxGzipBytes": 150000
  },
  "warnBudgets": {
    "defaultRouteMaxRawBytes": 150000,
    "heavyRouteMaxRawBytes": 200000
  },
  "heavyRouteChunkNames": [
    "AdminPages",
    "ChatRoomPage",
    "PostDetailPage"
  ],
  "requiredAsyncRoutes": [
    {
      "name": "AdminPages",
      "moduleId": "src/frontend/features/admin/pages/AdminPages.tsx"
    },
    {
      "name": "ChatRoomPage",
      "moduleId": "src/frontend/features/chat/pages/ChatRoomPage.tsx"
    },
    {
      "name": "PostDetailPage",
      "moduleId": "src/frontend/features/forum/pages/PostDetailPage.tsx"
    }
  ],
  "manualChunkGroups": [
    {
      "name": "react-runtime",
      "packages": ["react", "scheduler"]
    },
    {
      "name": "react-dom",
      "packages": ["react-dom"]
    },
    {
      "name": "router",
      "packages": ["react-router"]
    },
    {
      "name": "data-runtime",
      "packages": ["@tanstack/react-query", "@tanstack/query-core", "ky", "zustand"]
    },
    {
      "name": "ui-radix",
      "packages": [
        "radix-ui",
        "@radix-ui",
        "@floating-ui",
        "react-remove-scroll",
        "react-remove-scroll-bar",
        "react-style-singleton",
        "use-callback-ref",
        "use-sidecar",
        "aria-hidden"
      ]
    },
    {
      "name": "icons",
      "packages": ["lucide-react"]
    },
    {
      "name": "help-docs-runtime",
      "packages": ["yaml", "zod"]
    },
    {
      "name": "math-rendering",
      "packages": ["katex"]
    },
    {
      "name": "capture-utils",
      "packages": ["html2canvas"]
    }
  ],
  "fallbackVendorChunkName": "vendor"
}
