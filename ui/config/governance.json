{
  "tailwind_policy": "semantic-token-guarded",
  "theme_policy": "token-only",
  "scan": {
    "include_roots": ["src/frontend"],
    "exclude_roots": ["node_modules", "dist", "build", ".next", ".ai", ".codex", "coverage"]
  },
  "tailwind": {
    "allowed_utility_whitelist": [
      "sr-only",
      "truncate",
      "break-words",
      "break-all",
      "whitespace-nowrap"
    ],
    "disallowed_palette_prefixes": [
      "bg",
      "text",
      "border",
      "ring",
      "accent",
      "fill",
      "stroke",
      "decoration",
      "from",
      "via",
      "to",
      "shadow"
    ],
    "disallowed_palette_families": [
      "slate",
      "gray",
      "zinc",
      "neutral",
      "stone",
      "red",
      "orange",
      "amber",
      "yellow",
      "lime",
      "green",
      "emerald",
      "teal",
      "cyan",
      "sky",
      "blue",
      "indigo",
      "violet",
      "purple",
      "fuchsia",
      "pink",
      "rose",
      "black",
      "white"
    ],
    "disallowed_color_literal_substrings": ["#", "rgb(", "hsl("]
  },
  "code_rules": {
    "disallow_inline_style": true,
    "disallow_hardcoded_color_literals": true,
    "disallow_raw_box_shadow": true
  },
  "feature_css_rules": {
    "disallow_properties": [
      "color",
      "background",
      "background-color",
      "font",
      "font-family",
      "font-size",
      "font-weight",
      "line-height",
      "border-radius",
      "box-shadow",
      "margin",
      "padding"
    ]
  },
  "approvals": {
    "enabled": true,
    "approvals_dir": "ui/approvals",
    "enforce_spec_approval": true,
    "enforce_exception_approval": true,
    "auto_baseline_if_missing": true
  },
  "tools": {
    "eslint": {
      "enabled": "auto",
      "command": "npx eslint src/frontend --ext .ts,.tsx,.js,.jsx --format json --output-file {out}",
      "report": "eslint.json"
    },
    "stylelint": {
      "enabled": "auto",
      "command": "npx stylelint \"src/**/*.{css,scss}\" --formatter json --output-file {out}",
      "report": "stylelint.json"
    },
    "playwright": {
      "enabled": "auto",
      "command": "pnpm exec playwright test",
      "artifacts": ["playwright-report", "test-results"]
    }
  }
}
